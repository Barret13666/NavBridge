<?xml version="1.0" encoding="utf-8"?>
<!--
    The routing profile spinner used to live here. It has moved to Settings,
    along with language and the turn-guidance options: this screen is the one
    you look at with gloves on, at the roadside, and it should hold nothing but
    the address of the board and the button that starts the link.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!--
        The name-and-version heading that used to sit here is gone. It repeated
        the action bar word for word, and once the version was appended the
        screen said "NavBridge" twice, one line apart, with the only new
        information tucked into the second copy. The version now goes into the
        action bar title itself (see MainActivity) - top of the screen, no
        duplication, and nothing pushed down to make room for it.
    -->
    <EditText
        android:id="@+id/etIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/hint_ip"
        android:inputType="text" />

    <EditText
        android:id="@+id/etPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_port"
        android:inputType="number" />

    <Button
        android:id="@+id/btnStartStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/start" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textAlignment="center" />

    <!--
        The proxy row. No host field and no edit affordance: the server binds
        to every interface, and the dashboard already knows this phone's
        address from the GPS packets it receives, so there is nothing here for
        anyone to type or get wrong.
    -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchProxy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/label_http_proxy" />

    <TextView
        android:id="@+id/tvProxyStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:alpha="0.7" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnSettings"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings" />

    <Button
        android:id="@+id/btnAbout"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/about" />

</LinearLayout>
