<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to send UDP packets to the ESP32 over the local network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Needed for FusedLocationProviderClient, which blends GPS + WiFi/cell
         network location the same way the phone's own Maps app does -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Needed to keep sending location updates while the app is in the
         background / screen is off, via a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Needed to show the persistent "running" notification on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ (API 30+) package visibility: without this, this app
         cannot see or bind to the separately-installed BRouter app's routing
         service even with an explicit ComponentName -- bindService() would
         just fail silently. See BRouterClient.kt. -->
    <queries>
        <package android:name="btools.routingapp" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_notification"
        android:label="@string/app_name"
        android:theme="@style/Theme.Material3.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".NmeaForwardService"
            android:foregroundServiceType="location"
            android:exported="false" />

    </application>

</manifest>
